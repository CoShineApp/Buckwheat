{
  "name": "@slippi/slippi-js",
  "version": "9.0.0",
  "description": "Official Project Slippi Javascript SDK",
  "sideEffects": false,
  "license": "LGPL-3.0-or-later",
  "repository": "project-slippi/slippi-js",
  "author": {
    "name": "Jas Laferriere",
    "email": "jas.laferriere@gmail.com",
    "url": "https://github.com/JLaferri"
  },
  "files": [
    "node",
    "dist",
    "!dist/**/*.map"
  ],
  "main": "./dist/browser/index.cjs",
  "module": "./dist/browser/index.esm.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser/index.esm.js",
      "require": "./dist/browser/index.cjs",
      "default": "./dist/browser/index.esm.js"
    },
    "./node": {
      "types": "./dist/index.node.d.ts",
      "import": "./dist/node/index.esm.js",
      "require": "./dist/node/index.cjs",
      "default": "./dist/node/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/index.node.d.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "start": "rollup -c -w",
    "build:check": "tsc --noEmit",
    "build:js": "rollup -c",
    "build": "npm run build:check && npm run build:js",
    "coverage": "npm run test -- --coverage",
    "postcoverage": "open-cli coverage/lcov-report/index.html",
    "test": "jest --runInBand --verbose",
    "test:watch": "npm run test -- --watchAll --coverage",
    "test:ci": "npm run test -- --ci --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "patch": "npm version patch && npm publish",
    "minor": "npm version minor && npm publish",
    "major": "npm version major && npm publish",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "slippi-js",
    "slp-parser-js",
    "slp",
    "slippi",
    "melee",
    "ssbm"
  ],
  "dependencies": {
    "@shelacek/ubjson": "^1.0.1",
    "date-fns": "^3.3.0",
    "iconv-cp932": "^1.2.2",
    "lodash": "^4.17.21",
    "semver": "^7.3.2",
    "tslib": "^2.8.1"
  },
  "optionalDependencies": {
    "enet": "^0.2.9",
    "reconnect-core": "^1.3.0",
    "ws": ">=7.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged",
      "pre-push": "npm run lint --quiet"
    }
  },
  "yalcSig": "5797b8967ef0fa8f1e1aa3e7a29e6563"
}
